<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="11dp"
    android:viewportWidth="20"
    android:viewportHeight="11">
    <!-- Fill only: reaches the bottom edge so it merges with the bubble. -->
    <path
        android:fillColor="@color/recent_popup_bg"
        android:pathData="M0,11 L10,1 L20,11 Z" />
    <!-- Outline without the base edge, which would draw a divider line
         between the arrow and the bubble. -->
    <path
        android:pathData="M0,11 L10,1 L20,11"
        android:strokeColor="@color/recent_popup_divider"
        android:strokeLineCap="butt"
        android:strokeWidth="1" />
</vector>
